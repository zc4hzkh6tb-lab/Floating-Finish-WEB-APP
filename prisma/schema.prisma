generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Stammdaten ----------

model Series {
  id        String   @id @default(cuid())
  code      String   @unique // z. B. DTTO, NTTM, ETPC, GP, ATPI
  name      String
  note      String? // z. B. "Zeitnahme über Serie hinterlegt"
  color     String   @default("#f59e0b") // Leuchtfarbe in der Buchung
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  bookings  BookingSeries[]
}

model Package {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  description   String
  priceCategory String // grobe Preiskategorie, z. B. "€", "€€", "€€€"
  sortOrder     Int      @default(0)
  active        Boolean  @default(true)
  // Regeln für die Empfehlung aus Schritt 1
  maxPerspectives Int?
  maxSpeakers     Int?
  price           Float? // interner Preis pro VA-Tag (für Angebote)
  rigId           String?
  rig             Rig?     @relation(fields: [rigId], references: [id], onDelete: SetNull)
  minRules        BookingRule[]
  includedAddons  PackageAddon[]
  // Add-ons, die mit diesem Paket nicht funktionieren
  excludedAddons  PackageExcludedAddon[]
  bookings        BookingRequest[]
}

enum AddonGroup {
  KAMERA // Kameraperspektiven
  ADDON // Add-ons
  SONSTIGES // z. B. Sprecher, Interviews
  LED // LED-Wand (eigener Schritt)
}

model AddonCategory {
  id        String     @id @default(cuid())
  code      String     @unique
  name      String
  group     AddonGroup @default(ADDON)
  sortOrder Int     @default(0)
  addons    Addon[]
}

model Addon {
  id          String        @id @default(cuid())
  code        String        @unique
  name        String
  description String?
  categoryId  String
  category    AddonCategory @relation(fields: [categoryId], references: [id])
  priceHint   String? // grober Richtpreis, z. B. "ab 350 € / Tag"
  isLedWall   Boolean       @default(false) // löst die LED-Wand-Seite aus
  price       Float? // interner Preis pro Tag (für Angebote)
  sortOrder   Int           @default(0)
  active      Boolean       @default(true)
  articles    AddonArticle[]
  playouts    LedPlayoutOption[]
  inPackages  PackageAddon[]
  notWith     PackageExcludedAddon[]
  bookings    BookingAddon[]
}

model PackageAddon {
  packageId String
  addonId   String
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  addon     Addon   @relation(fields: [addonId], references: [id], onDelete: Cascade)

  @@id([packageId, addonId])
}

model VehicleClass {
  id        String  @id @default(cuid())
  name      String  @unique // z. B. "3,5 t Sport"
  sortOrder Int     @default(0)
  active    Boolean @default(true)
}

model LedSize {
  id        String  @id @default(cuid())
  label     String  @unique // z. B. "4 × 2,5 m"
  sortOrder Int     @default(0)
  active    Boolean @default(true)
}

enum QuestionType {
  TEXT
  NUMBER
  YESNO
  SELECT
}

// Eigene Fragen, die im Backoffice angelegt werden und auf Seite 0 erscheinen
model CustomQuestion {
  id        String       @id @default(cuid())
  label     String
  help      String?
  type      QuestionType @default(TEXT)
  options   String[] // nur bei SELECT
  required  Boolean      @default(false)
  sortOrder Int          @default(0)
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
}

model PackageExcludedAddon {
  packageId String
  addonId   String
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  addon     Addon   @relation(fields: [addonId], references: [id], onDelete: Cascade)

  @@id([packageId, addonId])
}

// ---------- Buchungsanfragen ----------

enum BookingStatus {
  ANFRAGE
  ANGEBOT
  BESTAETIGT
  IN_PLANUNG
  DURCHGEFUEHRT
  ABGERECHNET
  ABGESAGT
}

model BookingRequest {
  id        String        @id @default(cuid())
  number    Int           @unique @default(autoincrement())
  status    BookingStatus @default(ANFRAGE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // Seite 0 – Veranstaltung
  organizer        String
  contactName      String
  contactEmail     String
  contactPhone     String?
  eventName        String
  eventLocation    String
  expectedVisitors Int?
  classes          String // gefahrene Klassen, Freitext
  otherSeries      String? // freie Klassen / sonstige Serie
  catering         String?
  accommodation    String?
  internet         String?
  notes            String?
  // Antworten auf eigene Fragen: [{ label, answer }]
  customAnswers    Json?

  // Schritt 1 – Grundsetup
  perspectives   Int?
  speakers       Int?
  ledPlayout     String? // NONE | STREAM | STREAM_ADS | OWN_MIX
  packageId      String?
  package        Package? @relation(fields: [packageId], references: [id])

  internalNotes String?
  source        String  @default("BUCHUNG") // BUCHUNG | SCHNELL | INTERN
  customOffer   Boolean @default(false) // laut Regel eigenes Angebot nötig
  ruleHints     String[]
  organizerId   String?
  organizerRef  Organizer? @relation(fields: [organizerId], references: [id], onDelete: SetNull)
  locationId    String?
  locationRef   Location?  @relation(fields: [locationId], references: [id], onDelete: SetNull)

  offers     Offer[]
  materials  MaterialItem[]
  plans      Plan[]
  checklists Checklist[]
  chat       ChatChannel?
  days    BookingDay[]
  events  BookingEvent[]
  staff   StaffRequest[]
  series  BookingSeries[]
  addons  BookingAddon[]
  ledWall LedWallRequest?
}

model BookingDay {
  id        String         @id @default(cuid())
  bookingId String
  booking   BookingRequest @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  date      DateTime       @db.Date
  startTime String // "HH:MM"
  endTime   String
  note      String?
  addons    BookingAddonDay[]
  staff     StaffRequestDay[]
}

model BookingSeries {
  bookingId String
  seriesId  String
  booking   BookingRequest @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  series    Series         @relation(fields: [seriesId], references: [id])

  @@id([bookingId, seriesId])
}

model BookingAddon {
  id        String         @id @default(cuid())
  bookingId String
  addonId   String
  booking   BookingRequest @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  addon     Addon          @relation(fields: [addonId], references: [id])
  days      BookingAddonDay[]
}

model BookingAddonDay {
  bookingAddonId String
  dayId          String
  bookingAddon   BookingAddon @relation(fields: [bookingAddonId], references: [id], onDelete: Cascade)
  day            BookingDay   @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@id([bookingAddonId, dayId])
}

model LedWallRequest {
  id          String         @id @default(cuid())
  bookingId   String         @unique
  booking     BookingRequest @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  count       Int
  size        String
  placements  String[] // START, ZIEL, SEITE_LI, SEITE_RE, ENDE_LI, ENDE_RE
  hasMount    Boolean
  mountInfo   String?
}

// Historie einer Anfrage
model BookingEvent {
  id        String         @id @default(cuid())
  bookingId String
  booking   BookingRequest @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  actor     String // "Kunde" oder Backoffice-Benutzer
  text      String
}

// ---------- Nutzer & Personal ----------

enum Role {
  ADMIN // alles inkl. Nutzerverwaltung
  PLANUNG // Backoffice: Anfragen, Stammdaten, Personal
  TEAM // nur Team-App
}

model User {
  id                 String   @id @default(cuid())
  username           String   @unique
  name               String
  email              String?
  phone              String?
  passwordHash       String
  role               Role     @default(TEAM)
  active             Boolean  @default(true)
  mustChangePassword Boolean  @default(true)
  // Steckbrief
  position           String? // z. B. "Kamera, Regie"
  skills             String?
  bio                String?
  // Personalakte (nur Backoffice)
  street             String?
  zip                String?
  city               String?
  country            String?
  birthDate          DateTime? @db.Date
  emergencyContact   String?
  employment         String? // z. B. Festanstellung, Minijob, Freelancer
  dayRate            Float?
  internalNotes      String?
  qualifications     Qualification[]
  licenses           LicenseClass[]
  positions          Position[]
  chatMessages       ChatMessage[]
  icalToken          String   @unique @default(cuid())
  createdAt          DateTime @default(now())
  staffRequests      StaffRequest[]
}

enum StaffRequestStatus {
  OFFEN
  ZUGESAGT
  ABGESAGT
  ZURUECKGEZOGEN
}

model StaffRequest {
  id           String             @id @default(cuid())
  bookingId    String
  booking      BookingRequest     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  task         String // Aufgabe, z. B. "Kamera Erdwall"
  message      String?
  status       StaffRequestStatus @default(OFFEN)
  responseNote String?
  createdAt    DateTime           @default(now())
  respondedAt  DateTime?
  days         StaffRequestDay[]
}

model StaffRequestDay {
  staffRequestId String
  dayId          String
  staffRequest   StaffRequest @relation(fields: [staffRequestId], references: [id], onDelete: Cascade)
  day            BookingDay   @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@id([staffRequestId, dayId])
}

// ---------- Einstellungen ----------

model Setting {
  key   String @id
  value String
}

// ---------- Regeln für die Buchung ----------

enum RuleType {
  MIN_PACKAGE // Serie(n) brauchen mindestens Paket X
  CUSTOM_OFFER // Kombination nur mit eigenem Angebot
}

model BookingRule {
  id          String   @id @default(cuid())
  name        String
  type        RuleType
  seriesCodes String[]
  matchAll    Boolean  @default(false) // true: alle Serien müssen gewählt sein, false: eine reicht
  packageId   String?
  package     Package? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  message     String
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
}

model LedPlayoutOption {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?
  addonId     String? // wird automatisch mitgebucht
  addon       Addon?  @relation(fields: [addonId], references: [id], onDelete: SetNull)
  sortOrder   Int     @default(0)
  active      Boolean @default(true)
}

// ---------- Kunden & Orte ----------

model Organizer {
  id          String   @id @default(cuid())
  name        String
  contactName String?
  email       String?
  phone       String?
  street      String?
  zip         String?
  city        String?
  country     String?
  vatId       String?
  notes       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  bookings    BookingRequest[]
}

model Location {
  id          String   @id @default(cuid())
  name        String
  street      String?
  zip         String?
  city        String?
  country     String?
  contactName String?
  phone       String?
  power       String? // Stromanschlüsse
  internet    String?
  trackInfo   String? // Bahnlänge, Erdwall, Regieplatz …
  notes       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  bookings    BookingRequest[]
}

// ---------- Personal-Stammdaten ----------

model Qualification {
  id        String  @id @default(cuid())
  name      String  @unique
  sortOrder Int     @default(0)
  active    Boolean @default(true)
  users     User[]
}

model LicenseClass {
  id        String  @id @default(cuid())
  name      String  @unique
  sortOrder Int     @default(0)
  active    Boolean @default(true)
  users     User[]
}

model Position {
  id        String  @id @default(cuid())
  name      String  @unique
  sortOrder Int     @default(0)
  active    Boolean @default(true)
  users     User[]
}

// ---------- Lager & Technik ----------

model ArticleCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  sortOrder Int       @default(0)
  articles  Article[]
}

enum ArticleKind {
  GERAET
  ZUBEHOER
  KABEL
  VERBRAUCH
}

model Article {
  id              String           @id @default(cuid())
  number          String? // Artikelnummer
  name            String
  categoryId      String?
  category        ArticleCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  kind            ArticleKind      @default(GERAET)
  manufacturer    String?
  model           String?
  quantity        Int              @default(1) // Bestand
  unit            String           @default("Stk")
  storage         String? // Lagerort
  weightKg        Float?
  purchasePrice   Float?
  rentalPrice     Float? // interner Tagessatz
  customerVisible Boolean          @default(false) // Vorschlag beim Einfügen in Anlagen
  notes           String?
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  units           InventoryUnit[]
  rigItems        RigItem[]
  addonItems      AddonArticle[]
  materialItems   MaterialItem[]
}

enum UnitStatus {
  OK
  DEFEKT
  REPARATUR
  VERLIEHEN
  AUSGEMUSTERT
}

model InventoryUnit {
  id           String     @id @default(cuid())
  articleId    String
  article      Article    @relation(fields: [articleId], references: [id], onDelete: Cascade)
  inventoryNo  String?
  serial       String?
  status       UnitStatus @default(OK)
  purchaseDate DateTime?  @db.Date
  note         String?
}

// Anlage = Zusammenstellung aus Inventar
model Rig {
  id                  String    @id @default(cuid())
  name                String
  description         String? // intern
  customerDescription String? // sieht der Kunde
  sortOrder           Int       @default(0)
  active              Boolean   @default(true)
  items               RigItem[]
  packages            Package[]
}

model RigItem {
  id              String  @id @default(cuid())
  rigId           String
  rig             Rig     @relation(fields: [rigId], references: [id], onDelete: Cascade)
  articleId       String
  article         Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  quantity        Int     @default(1)
  customerVisible Boolean @default(false)
  note            String?
}

model AddonArticle {
  id              String  @id @default(cuid())
  addonId         String
  addon           Addon   @relation(fields: [addonId], references: [id], onDelete: Cascade)
  articleId       String
  article         Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  quantity        Int     @default(1)
  customerVisible Boolean @default(false)
}

// Materialliste eines Jobs
model MaterialItem {
  id        String         @id @default(cuid())
  bookingId String
  booking   BookingRequest @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  articleId String?
  article   Article?       @relation(fields: [articleId], references: [id], onDelete: SetNull)
  name      String
  quantity  Int            @default(1)
  source    String         @default("MANUELL") // PAKET | ADDON | MANUELL
  note      String?
  packed    Boolean        @default(false)
  sortOrder Int            @default(0)
}

// ---------- Angebote ----------

enum OfferStatus {
  ENTWURF
  VERSENDET
  ANGENOMMEN
  ABGELEHNT
}

model Offer {
  id         String         @id @default(cuid())
  number     Int            @unique @default(autoincrement())
  bookingId  String
  booking    BookingRequest @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  status     OfferStatus    @default(ENTWURF)
  title      String
  intro      String?
  outro      String?
  validUntil DateTime?      @db.Date
  vatRate    Float          @default(19)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  items      OfferItem[]
}

model OfferItem {
  id          String  @id @default(cuid())
  offerId     String
  offer       Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  position    Int     @default(0)
  name        String
  description String?
  quantity    Float   @default(1)
  unit        String  @default("Stk")
  unitPrice   Float   @default(0)
}

// ---------- Pläne ----------

model PlanSymbol {
  id        String  @id @default(cuid())
  name      String
  icon      String // Emoji oder kurzer Text
  color     String  @default("#f59e0b")
  kind      String  @default("POINT") // POINT | LINE
  sortOrder Int     @default(0)
  active    Boolean @default(true)
}

model Plan {
  id            String          @id @default(cuid())
  name          String
  bookingId     String?
  booking       BookingRequest? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  data          Json
  visibleToTeam Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

// ---------- Team: Chats & Checklisten ----------

model ChatChannel {
  id        String          @id @default(cuid())
  name      String
  bookingId String?         @unique
  booking   BookingRequest? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())
  messages  ChatMessage[]
}

model ChatMessage {
  id        String      @id @default(cuid())
  channelId String
  channel   ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime    @default(now())
}

model ChecklistTemplate {
  id        String   @id @default(cuid())
  name      String
  items     String[]
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
}

model Checklist {
  id        String          @id @default(cuid())
  bookingId String
  booking   BookingRequest  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime        @default(now())
  items     ChecklistItem[]
}

model ChecklistItem {
  id          String    @id @default(cuid())
  checklistId String
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  text        String
  done        Boolean   @default(false)
  doneBy      String?
  doneAt      DateTime?
  sortOrder   Int       @default(0)
}
